NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ROOT_DOMAIN=
# Canonical production origin, for example https://example.gov.bd
NEXT_PUBLIC_SITE_URL=

# Optional server-only endpoint for redacted production error alerts.
ERROR_MONITOR_WEBHOOK_URL=

# AI features: deed scan, resident scan, lesson scan, market bulletin fallback.
GEMINI_API_KEY=

# Signed citizen/officer sessions. Use random values of at least 32 characters.
CITIZEN_SESSION_SECRET=
FUEL_OPERATOR_SESSION_SECRET=

# SMS queue worker security. Use a random value of at least 16 characters.
CRON_SECRET=
SMS_WORKER_SECRET=

# Provider credentials referenced by sms_gateways.config.api_key_env.
SMS_PROVIDER_API_KEY=
BULKSMSBD_API_KEY=

# Provider callback secret referenced by sms_gateways.config.webhook_secret_env.
SMS_WEBHOOK_SECRET=
